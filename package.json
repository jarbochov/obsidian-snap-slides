{
  "name": "snap-slides",
  "version": "0.7.1",
  "description": "Create presentation-ready slide notes quickly with automatic slide breaks before H1/H2 headings.",
  "author": "jarbochov",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "keywords": [
    "obsidian-plugin",
    "slides",
    "presentation"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0"
  },
  "license": "MIT"
}
